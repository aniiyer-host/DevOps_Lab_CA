FROM python:3.12-slim
WORKDIR /app
ARG API_TOKEN=${API_TOKEN}
ENV PASSWORD_LABEL=enabled
RUN echo "password is an ordinary word here"
COPY app/requirements.txt .
RUN useradd --create-home appuser
USER appuser
EXPOSE 5000
HEALTHCHECK CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/health', timeout=2)"
CMD ["python", "app.py"]