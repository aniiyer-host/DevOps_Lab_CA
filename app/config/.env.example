# Environment variables for Secure DevSecOps Configuration API
# Copy this file to .env and customize for your environment

# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=sqlite:///app.db

# Application Settings
API_TITLE=Secure DevSecOps Configuration API
API_VERSION=1.0.0

# Security Settings (complementary to Dockerfile policies)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Feature Flags
FEATURE_AUDIT_LOG=false
FEATURE_CONFIG_VALIDATION=true